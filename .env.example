# Telegram bot token (from @BotFather)
BOT_TOKEN=

# Comma-separated list of Telegram user IDs allowed to use the bot, or * for all
ALLOWED_USER_IDS=

# Instagram enrichment (optional)
INSTAGRAM_ENRICHMENT_ENABLED=false
INSTAGRAM_ENRICHMENT_PROVIDER=meta_graph
INSTAGRAM_ENRICHMENT_API_KEY=
INSTAGRAM_ENRICHMENT_ACCOUNT_ID=
INSTAGRAM_GRAPH_API_VERSION=v21.0
INSTAGRAM_ENRICHMENT_TIMEOUT_SECONDS=3.0
INSTAGRAM_ENRICHMENT_MAX_CONCURRENCY=3
INSTAGRAM_ENRICHMENT_CACHE_TTL_SECONDS=86400
INSTAGRAM_ENRICHMENT_CACHE_PATH=
